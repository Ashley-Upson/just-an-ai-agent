@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="css/chat.css">

<div class="home-launcher">
    <div class="home-launcher-grid">
        <section class="home-launch-card" id="start-conversation-card" tabindex="0" role="button">
            <h2>Start a new conversation</h2>
            <ul class="list-group latest-list" id="latest-conversations-list"></ul>
        </section>

        <section class="home-launch-card" id="start-project-card" tabindex="0" role="button">
            <h2>Start a new project</h2>
            <ul class="list-group latest-list" id="latest-projects-list"></ul>
        </section>
    </div>
</div>

<script src="/js/home-dashboard.js"></script>
